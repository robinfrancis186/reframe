#!/usr/bin/env sh
set -eu
REFRAME_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then REFRAME_JAVA="$JAVA_HOME/bin/java"; else REFRAME_JAVA=java; fi
exec "$REFRAME_JAVA" -classpath "$REFRAME_ROOT/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
