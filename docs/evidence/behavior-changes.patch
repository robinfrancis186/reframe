+      '-ov',
+      '-format',
+      'UDZO',
+      path.resolve('out/make/Reframe-arm64-local-unsigned.dmg'),
+    ],
+    { maxBuffer: 1024 * 1024 },
+  );
+  console.log('Created out/make/Reframe-arm64-local-unsigned.dmg');
+} finally {
+  await rm(stage, { recursive: true, force: true });
+}
