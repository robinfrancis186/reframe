+  save: (candidate?: ComponentItem) => boolean;
+  scored: (fidelity: Fidelity) => void;
+  setPage: (page: string) => void;
+  setError: (text: string) => void;
+}
+export default function CaptureEditor({
+  model,
+  theme,
+  busy,
+  library,
+  open,
+  pick,
+  applyEdit,
+  copy,
+  changeTheme,
+  save,
+  scored,
+  setPage,
+  setError,
