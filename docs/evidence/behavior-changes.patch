+++ b/tests/library-sync.test.js
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, realpath, writeFile, rm } from 'node:fs/promises';
+import path from 'node:path';
+import { tmpdir } from 'node:os';
+import { build } from 'vite';
+import express from 'express';
+import { chromium } from 'playwright';
+import { LibraryStore, mountLibrary } from '../server/library-store.js';
+import { starters, themes } from '../src/model.ts';
+
+test(
+  'offline metadata operations survive reload, independent edits merge, and conflicting edits can become copies',
+  { timeout: 120000 },
+  async () => {
+    const root = await realpath(await mkdtemp(path.join(tmpdir(), 'reframe-sync-'))),
+      library = new LibraryStore(root);
+    let server, browser;
+    try {
+      for (const id of ['a', 'b'])
+        await library.put({
+          item: { ...starters[0], id, name: id.toUpperCase(), theme: themes[0] },
+          baseRevision: 0,
+        });
+      const module = path.resolve('src/storage.ts');
+      await writeFile(
+        path.join(root, 'index.html'),
+        '<div id="root"></div><script type="module" src="/main.tsx"></script>',
+      );
+      await writeFile(
+        path.join(root, 'main.tsx'),
+        `import React,{useState,useEffect}from'react';import{createRoot}from'react-dom/client';import{hydrateWorkspace,readWorkspace,writeWorkspace,onLibraryChange,onSyncStatus,syncStatus,recoverPendingCopies}from ${JSON.stringify(module)};await hydrateWorkspace();function App(){const [state,setState]=useState(JSON.parse(readWorkspace())),[status,setStatus]=useState(syncStatus());useEffect(()=>onLibraryChange(raw=>setState(JSON.parse(raw))),[]);useEffect(()=>onSyncStatus(setStatus),[]);function rename(id){const next={...state,items:state.items.map(i=>i.id===id?{...i,name:i.name+' edited'}:i)};writeWorkspace(JSON.stringify(next));setState(next);}return <><p role="status">{status.state}</p><button onClick={()=>rename('a')}>Rename A</button><button onClick={()=>rename('b')}>Rename B</button><button onClick={()=>recoverPendingCopies()}>Keep copies</button><ul>{state.items.map(i=><li key={i.id}>{i.name}</li>)}</ul></>};createRoot(document.getElementById('root')).render(<App/>);`,
+      );
+      await build({
+        root,
+        configFile: false,
+        envFile: false,
+        logLevel: 'error',
+        esbuild: { jsx: 'automatic' },
+        resolve: {
+          alias: {
+            react: path.resolve('node_modules/react'),
+            'react-dom': path.resolve('node_modules/react-dom'),
+          },
+        },
+        build: { target: 'esnext' },
+      });
+      const app = express(),
+        requests = [];
+      app.use((req, _res, next) => {
+        if (req.url.startsWith('/api/library')) requests.push({ method: req.method, url: req.url });
+        next();
+      });
+      mountLibrary(app, express, library);
+      app.use(express.static(path.join(root, 'dist')));
+      app.use((e, _req, res, _next) => res.status(e.status || 400).json({ error: e.message }));
+      server = await new Promise((resolve) => {
+        const s = app.listen(0, '127.0.0.1', () => resolve(s));
+      });
+      browser = await chromium.launch({ headless: true });
+      const one = await browser.newContext(),
+        two = await browser.newContext();
+      const p1 = await one.newPage(),
+        p2 = await two.newPage(),
+        url = 'http://127.0.0.1:' + server.address().port;
+      await p1.goto(url);
+      await p2.goto(url);
+      await p1.getByRole('button', { name: 'Rename A', exact: true }).waitFor();
+      await p2.getByRole('button', { name: 'Rename A', exact: true }).waitFor();
+      await one.setOffline(true);
+      await p1.getByRole('button', { name: 'Rename A', exact: true }).click();
+      await p1.getByRole('status').filter({ hasText: 'offline' }).waitFor();
+      await p1.getByRole('button', { name: 'Rename A', exact: true }).click();
+      await p1.getByRole('status').filter({ hasText: 'offline' }).waitFor();
+      await p2.getByRole('button', { name: 'Rename B', exact: true }).click();
+      await p2.getByRole('status').filter({ hasText: 'synced' }).waitFor();
+      await one.setOffline(false);
+      await p1.reload();
+      await p1.getByRole('status').filter({ hasText: 'synced' }).waitFor();
+      await p1.getByText('A edited edited', { exact: true }).waitFor();
+      await p1.getByText('B edited', { exact: true }).waitFor();
+      assert.equal((await library.item('a')).name, 'A edited edited');
+      assert.equal((await library.item('b')).name, 'B edited');
+      await p2.reload();
+      await p2.getByText('A edited edited', { exact: true }).waitFor();
+      await two.setOffline(true);
+      await p2.getByRole('button', { name: 'Rename A', exact: true }).click();
+      await p2.getByRole('status').filter({ hasText: 'offline' }).waitFor();
+      await p1.getByRole('button', { name: 'Rename A', exact: true }).click();
+      await p1.getByRole('status').filter({ hasText: 'synced' }).waitFor();
+      await two.setOffline(false);
+      await p2.reload();
+      await p2.getByRole('status').filter({ hasText: 'conflict' }).waitFor();
+      assert.equal((await library.index()).items.length, 2);
+      assert.equal((await library.item('a')).itemRevision, 4);
+      await p2.getByRole('button', { name: 'Keep copies', exact: true }).click();
+      await p2.getByRole('status').filter({ hasText: 'synced' }).waitFor();
+      assert.equal((await library.index()).items.length, 3);
+      assert.ok((await library.index()).items.some((i) => i.name.endsWith('(local copy)')));
+      assert.ok(
+        !requests.some((r) => r.method === 'PUT' && r.url === '/api/library'),
+        'no full-library uploads',
+      );
+      assert.ok(
+        !requests.some((r) => r.method === 'GET' && /^\/api\/library\/items\//.test(r.url)) ||
+          requests.filter((r) => r.method === 'GET' && /^\/api\/library\/items\//.test(r.url))
+            .length === 1,
+        'only explicit conflict recovery materializes a component',
+      );
+    } finally {
+      await browser?.close();
+      if (server) await new Promise((resolve) => server.close(resolve));
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+);
diff --git a/after/tests/library-v2.test.js b/tests/library-v2.test.js
new file mode 100644
index 0000000..b8f19e0
--- /dev/null
+++ b/tests/library-v2.test.js
@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, readFile, writeFile, readdir, rm, stat } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { LibraryStore } from '../server/library-store.js';
+import { themes } from '../src/model.ts';
+const item = (id = 'a') => ({
+  id,
+  name: 'Reference ' + id,
+  source: 'https://example.com/',
+  html: '<button>Choose ' + id + '</button>',
+  kind: 'button',
+  capturedAt: '2026-10-23T00:00:00Z',
+  evidence: 'Fixture',
+  tags: ['saved'],
+  collections: ['Client'],
+  theme: themes[0],
+});
+const sha = (value) => createHash('sha256').update(value).digest('hex');
+
+test('v2 migration preserves legacy workspace, fonts and histories; repeats safely after interruption', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'library-migration-'));
+  try {
+    const font = 'data:font/woff2;base64,QQ==',
+      hash = sha(font),
+      workspace = JSON.stringify({
+        version: 1,
+        theme: themes[0],
+        items: [{ ...item(), css: 'url("reframe-font:' + hash + '")' }],
+      });
+    const legacy = JSON.stringify({ revision: 3, savedAt: '2026-10-23', workspace });
+    await mkdir(path.join(dir, 'library/fonts'), { recursive: true });
+    await mkdir(path.join(dir, 'library/history'));
+    await writeFile(path.join(dir, 'library/fonts', hash), font);
+    await writeFile(path.join(dir, 'library/workspace.json'), legacy);
+    await writeFile(
+      path.join(dir, 'library/history/old.json'),
+      JSON.stringify({ id: 'old', revision: 1, savedAt: '2026-10-22', reason: 'save', workspace }),
+    );
+    const library = new LibraryStore(dir),
+      atomic = library.atomic.bind(library);
+    library.atomic = async (file, text) => {
+      if (file.endsWith('/index.json')) throw Error('Simulated interrupted migration');
+      return atomic(file, text);
+    };
+    await assert.rejects(library.index(), /interrupted/);
+    assert.equal(await readFile(path.join(dir, 'library/workspace.json'), 'utf8'), legacy);
+    const recovered = new LibraryStore(dir),
+      index = await recovered.summaries();
+    assert.equal(index.items.length, 1);
+    assert.equal(index.items[0]._summary, true);
+    assert.equal(index.items[0].html, '');
+    assert.equal((await recovered.item('a')).css, 'url("' + font + '")');
+    assert.equal(
+      await readFile(path.join(dir, 'library/workspace.v1.backup.json'), 'utf8'),
+      legacy,
+    );
+    assert.equal((await recovered.listHistory()).length, 1);
+    await recovered.restore({ id: 'old', baseRevision: 3 });
+    assert.equal((await recovered.index()).revision, 4);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test('metadata updates leave source bytes untouched and independent edits coexist; same-item conflicts stay recoverable', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'library-incremental-'));
+  try {
+    const library = new LibraryStore(dir);
+    const a = await library.put({ item: item(), baseRevision: 0 }),
+      b = await library.put({ item: item('b'), baseRevision: 0 });
+    const before = (await library.index()).items.find((e) => e.id === 'a'),
+      file = path.join(library.objects, before.body + '.json');
+    const original = await readFile(file, 'utf8'),
+      mtime = (await stat(file)).mtimeMs,
+      objects = await readdir(library.objects);
+    await Promise.all([
+      library.put({
+        id: 'a',
+        metadata: { name: 'Renamed', tags: ['client'] },
+        baseRevision: a.itemRevision,
+      }),
+      library.put({
+        id: 'b',
+        metadata: { collections: ['New collection'] },
+        baseRevision: b.itemRevision,
+      }),
+    ]);
+    assert.equal(await readFile(file, 'utf8'), original);
+    assert.equal((await stat(file)).mtimeMs, mtime);
+    assert.deepEqual(await readdir(library.objects), objects);
+    await assert.rejects(
+      library.put({ id: 'a', metadata: { name: 'Stale' }, baseRevision: 1 }),
+      (e) => e.status === 409,
+    );
+    assert.equal((await library.item('a')).name, 'Renamed');
+    assert.deepEqual((await library.item('b')).collections, ['New collection']);
+    const current = await library.index(),
+      atomic = library.atomic.bind(library);
+    library.atomic = async (file, text) => {
+      if (file.endsWith('/index.json')) throw Error('Interrupted commit');
+      return atomic(file, text);
+    };
+    await assert.rejects(
+      library.put({ item: { ...item(), html: '<button>Changed</button>' }, baseRevision: 2 }),
+      /Interrupted commit/,
+    );
+    assert.equal((await new LibraryStore(dir).index()).revision, current.revision);
+    assert.match((await library.item('a')).html, /Choose/);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test('replaying the same saved operation is idempotent and rejects invalid metadata', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'library-replay-'));
+  try {
+    const library = new LibraryStore(dir),
+      op = { item: item(), baseRevision: 0, operationId: 'same-operation' };
+    const first = await library.put(op),
+      again = await library.put(op);
+    assert.equal(first.revision, again.revision);
+    await assert.rejects(
+      library.put({ id: 'a', baseRevision: 1, metadata: { tags: ['Not normalized!'] } }),
+      /Invalid/,
+    );
+    await assert.rejects(
+      library.put({ id: 'a', baseRevision: 1, metadata: { html: '<script>' } }),
+      /Invalid/,
+    );
+    assert.equal((await library.summaries()).items.length, 1);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
