+  css.walkAtRules((rule) => {
+    if (/keyframes$/i.test(rule.name)) {
+      const previous = rule.params;
+      rule.params = code.scope + '-' + slug(previous);
+      animationNames.set(previous, rule.params);
+    }
+  });
