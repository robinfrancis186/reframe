+.home-workspace {
+  max-width: 1080px;
+  margin: 35px auto 44px;
+}
+.home-intro {
+  position: relative;
+  margin-bottom: 30px;
+  padding-right: 210px;
+}
+.home-intro h2 {
+  font:
+    650 clamp(35px, 3.5vw, 50px)/1.13 Inter,
+    system-ui,
+    sans-serif;
+  letter-spacing: -1.8px;
+  margin: 0;
+}
+.home-intro p {
+  font-size: 16px;
+  line-height: 1.65;
+  color: var(--muted);
+  margin: 20px 0 0;
+}
+.home-intro > .text-button {
+  position: absolute;
+  right: 0;
+  top: 58px;
+  font-size: 12px;
+  color: var(--blue);
+  padding: 0;
+  border: 0;
+  background: transparent;
+}
+.home-emphasis {
+  position: relative;
+  white-space: nowrap;
+}
+.home-emphasis:after {
+  content: '';
+  position: absolute;
+  left: -2px;
+  right: 0;
+  height: 5px;
+  bottom: -7px;
+  border-top: 3px solid var(--blue);
+  border-radius: 50%;
+  transform: rotate(-2deg);
+}
+.home-composer {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  padding: 20px;
+  margin-bottom: 16px;
+}
+.home-composer > label {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-bottom: 13px;
+  font-size: 12px;
+  font-weight: 500;
+}
+.home-composer > label > svg {
+  display: none;
+}
+.home-composer form {
+  display: flex;
+  align-items: stretch;
+  gap: 10px;
+}
+.home-composer form input {
+  height: 48px;
+  background: var(--raised);
+  font-size: 13px;
+  padding: 12px 16px;
+  border-radius: 8px;
+}
+.home-composer form button {
+  width: 48px;
+  flex-shrink: 0;
+  border-radius: 8px;
+}
+.home-composer .error-banner {
+  margin: 12px 0 0;
+}
+.home-sources {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 9px;
+  margin-top: 16px;
+  border-top: 1px solid var(--border);
+  padding-top: 14px;
+}
+.home-sources button {
+  min-width: 112px;
+  min-height: 38px;
+  background: transparent;
+  font-size: 12px;
+  gap: 9px;
+  border-radius: 7px;
+}
+.home-sources button:hover {
+  background: var(--raised);
+}
+.home-actions {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+  margin-bottom: 28px;
+}
+.home-action {
+  border: 1px solid var(--border);
+  background: var(--surface);
+  border-radius: 10px;
+  text-align: left;
+  justify-content: flex-start;
+  align-items: flex-start;
+  padding: 20px 17px;
+  gap: 15px;
+  min-height: 100px;
+}
+.home-action:hover {
+  background: var(--raised);
+}
+.home-action > span:not(.action-icon) {
+  min-width: 0;
+}
+.home-action strong {
+  font-size: 14px;
+  font-weight: 550;
+  display: block;
+  margin-bottom: 7px;
+}
+.home-action small {
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.65;
+  display: block;
+  font-weight: 400;
+}
+.home-action > svg {
+  display: none;
+}
+.action-icon {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  color: var(--blue);
+  padding-top: 2px;
+}
+.action-icon svg {
+  height: 23px;
+  width: 23px;
+}
+.home-section-heading {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 14px;
+}
+.home-section-heading h2 {
+  font-size: 17px;
+  font-weight: 550;
+  letter-spacing: -0.4px;
+}
+.home-section-heading button {
+  border: 0;
+  background: transparent;
+  color: var(--blue);
+  font-size: 12px;
+  padding-right: 0;
+}
+.starter-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+}
+.starter-card {
+  min-width: 0;
+  display: block;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 7px;
+  text-align: left;
+  overflow: hidden;
+}
+.starter-preview {
+  display: block;
+  position: relative;
+  height: 180px;
+  overflow: hidden;
+  border-radius: 5px;
+  background: #fff;
+  pointer-events: none;
+}
+.starter-preview .preview-frame.mini {
+  position: absolute;
+  left: 50%;
+  margin-left: -350px;
+  width: 700px;
+  height: 500px;
+  min-height: 500px;
+  transform: scale(0.36);
+  transform-origin: top center;
+  border: 0;
+}
+.starter-title {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 10px;
+  padding: 13px 5px 7px;
+  font-size: 12px;
+}
+.starter-title svg {
+  color: var(--muted);
+}
+.sidebar-recent {
+  border-top: 1px solid var(--border);
+  padding: 24px 8px;
+  margin-top: 22px;
+}
+.sidebar-recent h2 {
+  font-size: 11px;
+  letter-spacing: 0;
+  font-weight: 450;
+  color: var(--muted);
+  margin-bottom: 14px;
+}
+.sidebar-recent button {
+  display: flex;
+  border: 0;
+  background: transparent;
+  justify-content: flex-start;
+  width: 100%;
+  font-size: 12px;
+  padding: 10px 0;
+  color: var(--muted);
+}
+.sidebar-recent button span {
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+.sidebar-recent button svg {
+  flex-shrink: 0;
+}
+.home-main > .app-footer {
+  max-width: 1080px;
+  margin: auto;
+  font-size: 10px;
+}
+@media (max-width: 1200px) {
+  .home-intro h2 {
+    font-size: 40px;
+  }
+  .home-intro {
+    padding-right: 0;
+  }
+  .home-intro > .text-button {
+    position: static;
+    display: flex;
+    margin-top: 14px;
+  }
+  .home-action {
+    padding: 18px 14px;
+    gap: 12px;
+  }
+  .home-action strong {
+    font-size: 13px;
+  }
+  .home-action small {
+    font-size: 11px;
+  }
+  .starter-preview .preview-frame.mini {
+    transform: scale(0.3);
+  }
+  .starter-preview {
+    height: 150px;
+  }
+}
+@media (max-width: 850px) {
+  .sidebar-recent {
+    display: none;
+  }
+  .home-workspace {
+    margin-top: 22px;
+  }
+  .home-intro h2 {
+    font-size: 40px;
+  }
+  .home-intro p {
+    font-size: 14px;
+  }
+  .home-actions {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+@media (max-width: 600px) {
+  .home-workspace {
+    margin-top: 20px;
+    margin-bottom: 30px;
+  }
+  .home-intro {
+    margin-bottom: 25px;
+  }
+  .home-intro h2 {
+    font-size: 34px;
+    letter-spacing: -1.1px;
+    max-width: 340px;
+  }
+  .desktop-heading-break {
+    display: none;
+  }
+  .home-intro p {
+    font-size: 13px;
+    line-height: 1.7;
+  }
+  .home-intro > .text-button {
+    font-size: 11px;
+  }
+  .home-actions {
+    grid-template-columns: 1fr;
+    gap: 9px;
+  }
+  .home-action {
+    padding: 17px;
+    min-height: 84px;
+    border-radius: 10px;
+  }
+  .home-action strong {
+    font-size: 14px;
+  }
+  .home-action small {
+    font-size: 12px;
+  }
+  .home-composer {
+    padding: 16px;
+  }
+  .home-composer form input {
+    font-size: 12px;
+  }
+  .home-sources {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 8px;
+  }
+  .home-sources button {
+    min-height: 44px;
+    min-width: 0;
+  }
+  .home-section-heading h2 {
+    font-size: 15px;
+  }
+  .home-section-heading button {
+    font-size: 11px;
+  }
+  .starter-grid {
+    grid-template-columns: 1fr;
+  }
+  .starter-preview {
+    height: 200px;
+  }
+  .starter-preview .preview-frame.mini {
+    transform: scale(0.4);
+  }
+  .starter-title {
+    padding: 14px 7px 8px;
+    font-size: 13px;
+  }
+}
