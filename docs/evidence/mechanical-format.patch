+.library-tools {
+  display: grid;
+  gap: 18px;
+  margin: 26px 0;
+}
+.library-search {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  max-width: 480px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 0 14px;
+  background: var(--surface);
+}
+.library-search input {
+  border: 0;
+  background: transparent;
+  width: 100%;
+  padding: 13px 0;
+  min-width: 0;
+}
+.library-filters {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+.library-filters button {
+  border-radius: 30px;
+  padding: 7px 15px;
+}
+.library-filters button[aria-pressed='true'] {
+  background: var(--text);
+  color: var(--surface);
+  border-color: var(--text);
+}
+.library-workspace {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(310px, 0.85fr);
+  gap: 24px;
+  align-items: start;
+}
+.library-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 14px;
+}
+.library-card {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  text-align: left;
+  padding: 20px;
+  min-height: 205px;
+  border-radius: 14px;
+  gap: 12px;
+  background: var(--surface);
+  transition: border-color 0.15s;
+}
+.library-card:hover,
+.library-card.selected {
+  border-color: var(--muted);
+}
+.library-card.selected {
+  box-shadow: inset 0 0 0 1px var(--muted);
+}
+.library-card-number {
+  display: flex;
+  justify-content: space-between;
+  color: var(--muted);
+  font-size: 12px;
+  margin-bottom: 10px;
+}
+.library-card strong {
+  font-size: 16px;
+  letter-spacing: -0.02em;
+}
+.library-card > span:not(.library-card-number) {
+  font-size: 12px;
+  color: var(--muted);
+  font-weight: 400;
+  line-height: 1.6;
+}
+.library-card small {
+  font-size: 10px;
+  color: var(--muted);
+  margin-top: auto;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+}
+.library-detail {
+  position: sticky;
+  top: 100px;
+  overflow: hidden;
+}
+.library-detail .library-preview {
+  width: auto;
+  margin: 18px;
+  min-height: 310px;
+}
+.library-detail-actions {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  padding: 0 22px;
+}
+.library-detail > p {
+  padding: 4px 22px 14px;
+  font-size: 12px;
+  line-height: 1.7;
+}
+.library-preview {
+  width: 100%;
+  display: grid;
+  align-content: center;
+  min-height: 250px;
+  overflow-wrap: anywhere;
+}
+.canvas > .library-preview {
+  padding: 28px;
+  max-width: 100%;
+  min-height: 390px;
+}
+.mobile-canvas > .library-preview {
+  max-width: 390px;
+  margin: auto;
+  padding: 12px;
+}
+.library-preview.mini {
+  pointer-events: none;
+  min-height: 0;
+  max-height: 220px;
+  overflow: hidden;
+}
+.library-preview.mini .rf-library {
+  font-size: 12px;
+  padding: 20px;
+}
+.brand-detection {
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  padding: 20px;
+  margin: 0 0 24px;
+  background: var(--surface);
+}
+.brand-detection h3,
+.brand-fields h3 {
+  font-size: 15px;
+  margin: 0 0 8px;
+}
+.brand-detection > p {
+  font-size: 12px;
+  line-height: 1.7;
+}
+.brand-detection label {
+  display: grid;
+  gap: 8px;
+  font-size: 12px;
+}
+.brand-detection select {
+  width: 100%;
+  max-width: 100%;
+}
+.brand-scan-row {
+  display: flex;
+  align-items: end;
+  gap: 10px;
+  margin: 14px 0;
+}
+.brand-scan-row label {
+  flex: 1;
+}
+.brand-detection .brand-auto {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  line-height: 1.5;
+}
+.brand-auto input {
+  width: auto;
+  accent-color: var(--blue);
+}
+.brand-evidence {
+  list-style: none;
+  padding: 0;
+  max-height: 280px;
+  overflow: auto;
+}
+.brand-evidence li {
+  display: grid;
+  gap: 4px;
+  border-bottom: 1px solid var(--border);
+  padding: 12px 0;
+  font-size: 12px;
+  overflow-wrap: anywhere;
+}
+.brand-evidence small {
+  color: var(--muted);
+}
+.brand-fields {
+  border-top: 1px solid var(--border);
+  padding-top: 20px;
+}
+.brand-logo-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.brand-logo-row img {
+  max-width: 70px;
+  max-height: 60px;
+  object-fit: contain;
+}
+.theme-page .theme-editor {
+  min-width: 0;
+}
+.theme-preview .canvas .library-preview {
+  min-height: 450px;
+}
+.projects-page > .brand-detection {
+  margin-top: 20px;
+}
+.brand-detection details {
+  font-size: 12px;
+}
+.theme-editor > button {
+  margin: 8px 6px 0 0;
+}
+@media (max-width: 1100px) {
+  .library-workspace {
+    grid-template-columns: 1fr;
+  }
+  .library-detail {
+    position: static;
+    order: -1;
+  }
+  .library-detail .library-preview {
+    min-height: 260px;
+  }
+}
+@media (max-width: 600px) {
+  .library-grid {
+    grid-template-columns: 1fr;
+  }
+  .library-card {
+    min-height: 175px;
+  }
+  .canvas > .library-preview {
+    padding: 12px;
+  }
+  .library-detail .library-preview {
+    margin: 10px;
+  }
+  .rf-library {
+    padding: 20px;
+  }
+  .brand-detection {
+    padding: 16px;
+  }
+}
 
