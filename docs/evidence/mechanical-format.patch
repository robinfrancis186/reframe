-.project-list button.selected,.integration-item.selected,.tree-list .selected { background:#2c333c; border-color:#8394a7; }
-.integration-grid { grid-template-columns:210px minmax(0,1fr) 280px; gap:18px; align-items:start; }
-.integration-library { padding:20px 15px; }
