-.clipboard-heading { margin:0 0 16px; }
-.empty-library { border:1px dashed var(--border); border-radius:9px; padding:24px; background:var(--surface); }
-.clip-card { border-color:var(--border); border-radius:9px; }
-.app-footer { color:var(--muted); border-top:0; padding:24px 0; }
-.connection-panel { padding:18px 22px; margin-bottom:20px; }
-.connection-panel .section-heading { padding:0; }
