-.media-player.empty video { visibility:hidden; height:220px; }
-.media-player.empty p { position:absolute; inset:0; display:flex; flex-direction:column; gap:14px; align-items:center; justify-content:center; color:var(--muted); font-size:13px; }
-.media-controls button { font-size:12px; }
-.recording-indicator { color:#eda5ad; font-size:12px; font-weight:600; }
-.frame-strip { display:flex; overflow:auto; gap:10px; margin:18px 0; padding:3px; }
-.frame-strip figure { margin:0; min-width:130px; width:130px; background:var(--surface); border:1px solid var(--border); border-radius:7px; overflow:hidden; }
-.frame-strip img { width:100%; height:90px; object-fit:contain; display:block; }
-.frame-strip figcaption { padding:5px 7px; display:flex; align-items:center; justify-content:space-between; font-size:10px; }
-.frame-strip figcaption button { min-height:28px; padding:3px; border:0; background:transparent; }
-.single-frame figure { width:100%; }
-.single-frame img { height:250px; }
-.media-capture > small { display:block; margin-bottom:20px; font-size:11px; }
-.engine-list { display:grid; gap:16px; }
-.engine-row { display:flex; align-items:center; justify-content:space-between; padding:25px 28px; gap:30px; }
-.engine-row > div { max-width:760px; }
-.engine-row > button { flex-shrink:0; }
-.engine-row h2 { font-size:19px; margin:10px 0; }
-.engine-row p { color:var(--muted); line-height:1.7; font-size:13px; margin:8px 0; }
-.engine-row small,.engine-row a { font-size:11px; color:var(--muted); }
-.engine-state { font-size:11px; color:#9bd4b8; }
-.engine-state.pending { color:#e1bf85; }
-.polish-review { padding:26px; margin-top:22px; }
-.polish-review > p { margin-top:16px; }
-.copy-comparison { display:grid; grid-template-columns:1fr 1fr; margin:20px 0; gap:0 20px; }
-.copy-pair { display:contents; }
-.copy-pair p { border-top:1px solid var(--border); margin:12px 0 0; padding:14px 0; line-height:1.7; font-size:13px; }
-.engines-page .analysis-result { padding:24px; margin-top:22px; }
-.engines-page .analysis-result p { line-height:1.65; overflow-wrap:anywhere; }
-.engines-page .analysis-result details { margin-top:16px; }
-.engines-page .polish-review textarea { display:block; width:100%; margin:10px 0 18px; font-family:monospace; }
-.engines-page .engine-row small { display:block; margin:8px 0; }
