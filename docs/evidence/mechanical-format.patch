-.sidebar { background:#202020; border-right:1px solid #30302f; padding:28px 16px 24px; overflow-y:auto; }
-.brand { color:var(--text); font:normal 30px/1.2 Georgia,serif; letter-spacing:-.8px; gap:10px; margin:0 10px 34px; }
-.brand svg { color:var(--text); }
-.sidebar nav { gap:6px; }
-.sidebar nav button { color:#cdcdc9; padding:12px 13px; font-size:14px; min-height:44px; }
-.sidebar nav button.active { color:var(--text); background:#30302f; box-shadow:none; }
-.sidebar nav button:hover { color:var(--text); background:var(--raised); }
-.sidebar .count { background:var(--raised); color:var(--text); padding:2px 6px; border-radius:4px; }
-.workspace-label { color:var(--muted); border-color:var(--border); font-size:12px; padding:20px 7px 0; }
-.workspace-label small { color:var(--muted); font-size:11px; }
-main { max-width:1900px; padding:0 32px; }
-.page-header { height:78px; border-bottom:1px solid #2b2b29; margin:0 -32px 26px; padding:0 32px; gap:28px; background:var(--sunken); }
-.home-main .page-header { border-bottom:0; margin-bottom:0; }
-.page-header h1 { font-size:17px; letter-spacing:-.3px; font-weight:600; }
-.page-header > .primary { margin-left:auto; font-size:13px; }
-.workflow-steps { display:flex; align-items:center; gap:8px; color:var(--muted); }
-.workflow-steps button { background:none; border:0; color:var(--muted); padding:6px; font-size:12px; }
-.workflow-steps button:hover { color:var(--blue); }
-.intro { margin-bottom:24px; }
-.intro h2 { font-size:30px; letter-spacing:-1.1px; font-weight:600; margin-bottom:10px; max-width:none; }
-.intro p { font-size:14px; color:var(--muted); }
-.capture-strip { display:flex; gap:18px; margin-bottom:24px; align-items:center; }
-.url-form { flex:1; min-width:0; margin:0; gap:8px; }
-.url-form label { border-color:var(--border); }
-.url-form input:not([type=range]) { font-size:13px; }
-.url-form > button { min-width:138px; font-size:12px; }
-.capture-shortcuts { display:flex; gap:8px; padding-left:18px; border-left:1px solid var(--border); }
-.capture-shortcuts button { font-size:12px; padding:11px 13px; }
-.panel { border-radius:9px; box-shadow:0 2px 4px #20222a02; }
-.workbench { grid-template-columns:220px minmax(0,1fr) 250px; gap:16px; margin-bottom:28px; }
-.section-heading { padding:18px; }
-.section-heading h2,.inspector h2 { font-size:14px; letter-spacing:-.2px; }
-.element-list { padding:0 12px 12px; max-height:510px; overflow:auto; }
-.element { display:grid; grid-template-columns:1fr auto; padding:8px; gap:10px; margin-bottom:12px; }
-.element.selected { border-color:#899aad; background:#2c333c; }
-.element-thumb { width:100%; height:106px; grid-column:1/-1; background:var(--surface); border-color:var(--border); }
-.element-thumb .mini { width:650px; height:420px; transform:scale(.275); min-height:420px; }
-.element > span { padding:2px 3px 5px; }
-.element strong { font-size:12px; }
-.element small { font-size:10px; max-width:155px; color:var(--muted); }
-.source-note { color:var(--muted); padding:15px; }
-.source-note p { font-size:11px; line-height:1.6; }
-.preview-panel { min-height:600px; }
-.preview-toolbar { height:56px; padding:0 20px; }
-.view-tabs { gap:22px; }
-.view-tabs button { font-size:12px; }
-.device-toggle { border-color:var(--border); }
-.device-toggle button.selected { background:#39414b; border-color:#8394a7; color:var(--text); }
-.canvas { background-color:var(--sunken); background-image:radial-gradient(#3c3c3a .7px,transparent .7px); background-size:14px 14px; }
-.canvas,.preview-frame { min-height:515px; }
-.canvas-footer { padding:10px 15px; }
-.canvas-footer button { font-size:11px; }
-.inspector { padding:21px 19px; gap:18px; }
-.inspector > h2 { margin-bottom:0; }
-.inspector label { font-size:12px; }
-.inspector-actions { margin-top:12px; gap:9px; }
-.inspector-actions button { min-height:40px; font-size:12px; }
-.fit-link { width:100%; margin-top:10px; min-height:40px; color:var(--muted); background:var(--surface); border-color:var(--border); font-size:12px; }
-.quality { margin-top:12px; }
