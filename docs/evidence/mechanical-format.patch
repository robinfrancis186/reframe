+.library-tools .library-search input[type='search'] {
+  border: 0;
+  background: transparent;
+  padding: 12px 0;
+  box-shadow: none;
+}
+.library-platforms {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 16px 22px;
+}
+.library-detail pre {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  font-size: 11px;
+  max-height: 360px;
+  overflow: auto;
+  padding: 18px;
+}
+.library-requirements {
+  font-size: 12px;
+  line-height: 1.7;
+  margin: 14px 22px;
+  padding-left: 18px;
+}
+.library-filters {
+  max-width: 100%;
+}
+.library-coverage {
+  font-size: 12px;
+  line-height: 1.6;
+  color: var(--muted);
+}
+.rf-library .rf-gallery-window {
+  overflow: auto;
+  max-width: 100%;
+  padding: 20px 0;
+}
+.rf-library .rf-artwork {
+  transform-origin: center;
+  transition: transform 0.2s;
+}
+.integration-item [data-drag-handle] {
+  display: grid;
+  place-items: center;
+  flex-shrink: 0;
+  width: 32px;
+  min-height: 40px;
+  touch-action: none;
+  cursor: grab;
+}
+.integration-item [data-drag-handle]:active {
+  cursor: grabbing;
+}
+.integration-drag-preview {
+  position: fixed;
+  z-index: 1000;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+  max-width: 260px;
+  padding: 12px 16px;
+  background: var(--text);
+  color: var(--surface);
+  border-radius: 10px;
+  box-shadow: 0 8px 30px #0005;
+  font-size: 12px;
+}
+.thumbnail-open {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+  border-radius: inherit;
+  background: transparent !important;
+  padding: 0;
+  cursor: pointer;
+}
+.thumbnail-open:focus-visible {
+  outline: 3px solid var(--blue);
+  outline-offset: -3px;
+}
+.element {
+  position: relative;
+}
+.element-open {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+  border-radius: inherit;
+  background: transparent !important;
+  padding: 0;
+  cursor: pointer;
+}
+.element-open:focus-visible {
+  outline: 3px solid var(--blue);
+  outline-offset: -3px;
+}
