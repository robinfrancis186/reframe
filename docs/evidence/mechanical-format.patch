+  const find = (filter) => items.filter((i) => matchesLibrary(i, filter)).map((i) => i.name);
+  assert.deepEqual(find({ query: 'apple navigation' }), ['Global nav']);
+  assert.deepEqual(find({ query: '#0071e3' }), ['Global nav']);
+  assert.deepEqual(find({ query: 'DARK' }), ['Global nav']);
+  assert.deepEqual(find({ query: 'wikipedia hero' }), ['Hero tile']);
+  assert.deepEqual(find({ query: 'apple hero' }), [], 'every word must match');
+  assert.deepEqual(find({ type: 'Card' }), ['Pricing card']);
+  assert.deepEqual(find({ collection: 'Headers' }), ['Global nav']);
+  assert.deepEqual(find({ tag: 'launch' }), ['Hero tile']);
+  assert.deepEqual(find({ site: 'wikipedia.org' }), ['Hero tile']);
+  assert.deepEqual(
+    sortLibrary(items, 'newest').map((i) => i.name),
+    ['Hero tile', 'Pricing card', 'Global nav'],
+  );
+  assert.deepEqual(
+    sortLibrary(items, 'oldest').map((i) => i.name),
+    ['Global nav', 'Pricing card', 'Hero tile'],
+  );
+  assert.deepEqual(
+    sortLibrary(items, 'name').map((i) => i.name),
+    ['Global nav', 'Hero tile', 'Pricing card'],
+  );
+  assert.deepEqual(
+    sortLibrary(items, 'match').map((i) => i.name),
+    ['Global nav', 'Hero tile', 'Pricing card'],
+    'unscored last',
+  );
+  assert.deepEqual(
+    items.map((i) => i.name),
+    ['Global nav', 'Hero tile', 'Pricing card'],
+    'sorting does not reorder the saved list',
+  );
+  const counts = facets(items);
+  assert.deepEqual(counts.types, [
+    ['Card', 1],
+    ['Hero', 1],
+    ['Navigation', 1],
+  ]);
+  assert.deepEqual(counts.collections, [['Headers', 1]]);
+  assert.deepEqual(counts.tags, [
+    ['dark mode', 1],
+    ['launch', 1],
+  ]);
 });
