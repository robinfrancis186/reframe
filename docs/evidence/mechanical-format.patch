+.originals-page .intro {
+  max-width: 760px;
+}
+.library-result-count {
+  font-size: 12px;
+  color: var(--muted);
+  margin: 0 0 22px;
+}
+.library-grid {
+  gap: 18px;
+}
+.library-card {
+  padding: 0;
+  gap: 0;
+  min-height: 0;
+  overflow: hidden;
+  display: block;
+}
+.library-card.selected {
+  box-shadow: inset 0 0 0 1px var(--muted);
+}
+.library-sample {
+  position: relative;
+  height: 150px;
+  overflow: hidden;
+  background: var(--raised);
+  border-bottom: 1px solid var(--border);
+  padding: 14px;
+  pointer-events: none;
+}
+.library-sample .library-preview.mini {
+  position: absolute;
+  left: 50%;
+  top: 14px;
+  width: 340px;
+  max-height: none;
+  transform: translateX(-50%) scale(0.6);
+  transform-origin: top center;
+}
+.library-sample .rf-library {
+  padding: 20px;
+}
+.library-card-select {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  width: 100%;
+  padding: 18px;
+  text-align: left;
+  border: 0;
+  background: transparent;
+  gap: 10px;
+  border-radius: 0;
+  min-height: 185px;
+  white-space: normal;
+}
+.library-card-select > span:not(.library-card-number) {
+  font-size: 12px;
+  line-height: 1.6;
+  color: var(--muted);
+  font-weight: 400;
+}
+.library-card-select .library-card-number {
+  font-size: 11px;
+  margin: 0;
+}
+.library-card-select small {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 10px;
+  text-transform: none;
+  letter-spacing: 0;
+}
+.library-rating {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  margin: 0 22px;
+  padding: 18px 0;
+  border-top: 1px solid var(--border);
+  border-bottom: 1px solid var(--border);
+  flex-wrap: wrap;
+}
+.library-rating > div > strong {
+  font-size: 29px;
+  letter-spacing: -0.04em;
+  display: flex;
+  align-items: baseline;
+  gap: 5px;
+}
+.library-rating small,
+.library-rating > div > span {
+  display: block;
+  font-size: 10px;
+  color: var(--muted);
+  font-weight: 400;
+  letter-spacing: 0;
+}
+.library-rating dl {
+  display: flex;
+  gap: 18px;
+  margin: 0;
+}
+.library-rating dt {
+  font-size: 10px;
+  color: var(--muted);
+}
+.library-rating dd {
+  font-size: 17px;
+  margin: 4px 0 0;
+}
+.library-level {
+  font-size: 10px;
+  padding: 6px 9px;
+  border: 1px solid var(--border);
+  border-radius: 20px;
+  color: var(--muted);
+  margin-left: auto;
+}
+.library-detail .library-review-note {
+  padding-top: 12px;
+  margin-bottom: 0;
+}
+.library-detail .library-source {
+  margin: 0 22px 18px;
+  font-size: 12px;
+}
+.library-detail summary {
+  cursor: pointer;
+  padding: 8px 0;
+}
+.library-detail .library-preview {
+  min-height: 0;
+}
+.library-detail:focus {
+  outline: 2px solid var(--muted);
+  outline-offset: 4px;
+}
+.library-detail-actions {
+  padding-top: 8px;
+}
+.library-card-select:focus-visible {
+  outline: 2px solid var(--text);
+  outline-offset: -4px;
+}
+@media (max-width: 600px) {
+  .library-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
