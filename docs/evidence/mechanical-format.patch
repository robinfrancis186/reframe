+  }
+  .library-card-select strong {
+    font-size: 14px;
+  }
+  .library-sample {
+    height: 110px;
+    padding: 10px;
+  }
+  .library-sample .library-preview.mini {
+    transform: translateX(-50%) scale(0.42);
+  }
+  .library-rating {
+    gap: 14px;
+    margin: 0 18px;
+  }
+  .library-level {
+    margin-left: 0;
+  }
+}
+@media (max-width: 360px) {
+  .library-grid {
