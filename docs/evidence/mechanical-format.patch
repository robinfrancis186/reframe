-.fit-score { display:flex; align-items:baseline; gap:8px; margin-top:24px; }
-.fit-score > strong { font-size:56px; letter-spacing:-3px; font-weight:550; color:var(--muted); line-height:1.15; }
-.fit-score > span { color:var(--muted); font-size:16px; }
-.fit-categories { margin:23px 0; }
-.fit-categories details { margin-bottom:15px; }
-.fit-categories summary { display:flex; justify-content:space-between; align-items:center; cursor:pointer; font-size:12px; }
-.fit-categories summary::after { content:'+'; margin-left:8px; color:var(--muted); }
-.fit-categories details[open] summary::after { content:'−'; }
-.fit-categories summary > strong { margin-left:auto; font-size:12px; font-weight:550; }
-.fit-categories summary small { color:var(--muted); font-weight:400; font-size:10px; }
-.fit-categories meter { display:block; width:100%; height:7px; margin-top:8px; background:var(--surface); border-radius:5px; appearance:none; }
-.fit-categories meter::-webkit-meter-bar { background:var(--surface); border:0; height:6px; border-radius:5px; }
