+.component-journey {
+  margin: 0 0 22px;
+}
+.journey-heading {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 15px;
+}
+.journey-heading h2 {
+  font-size: 19px;
+  margin: 7px 0;
+}
+.component-journey > p {
+  color: var(--muted);
+  font-size: 13px;
+  line-height: 1.7;
+  margin: 6px 0 18px;
+}
+.journey-steps {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 10px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.journey-steps button {
+  display: grid;
+  grid-template-columns: 28px 1fr;
+  width: 100%;
+  text-align: left;
+  justify-content: start;
+  padding: 14px;
+  gap: 5px 10px;
+  min-height: 88px;
+}
+.journey-steps button > span {
+  grid-row: 1/3;
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  width: 26px;
+  height: 26px;
+  display: grid;
+  place-items: center;
+}
+.journey-steps strong {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 12px;
+}
+.journey-steps small {
+  font-size: 11px;
+  color: var(--muted);
+  line-height: 1.6;
+}
+.journey-steps button:disabled {
+  opacity: 1;
+}
+.preview-explanation {
+  padding: 12px 16px;
+  margin: 0;
+  border-bottom: 1px solid var(--border);
+  font-size: 12px;
+  line-height: 1.7;
+  color: var(--muted);
+  background: var(--raised);
+}
+.clipboard-filters {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin: 14px 0;
+}
+.clipboard-filters button[aria-pressed='true'] {
+  background: var(--text);
+  color: var(--surface);
+}
+.component-status {
+  display: inline-flex;
+  font-size: 11px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  padding: 5px 8px;
+  margin: 4px 0 7px;
+  color: var(--muted);
+}
+.clip-card .component-status {
+  margin: 4px 12px;
+}
+.clip-card > .clip-handoff {
+  margin: 8px 12px;
+  width: calc(100% - 24px);
+}
+.home-resume {
+  display: flex;
+  gap: 18px;
+  justify-content: space-between;
+  align-items: center;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+  padding: 18px;
+  margin: 20px 0;
+}
+.home-resume p {
+  margin: 7px 0 0;
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.7;
+}
+.home-resume button {
+  flex: none;
+}
+.home-start-guide {
+  margin: 20px 0;
+  line-height: 1.7;
+}
+.home-start-guide summary {
+  font-size: 13px;
+}
+.home-start-guide ol {
+  color: var(--muted);
+  font-size: 13px;
+  padding-left: 23px;
+}
+.install-receipt {
+  border: 1px solid var(--border);
+  padding: 18px;
+  margin: 16px 0;
+  background: var(--raised);
+  border-radius: 10px;
+}
+.install-receipt h3 {
+  margin: 0 0 8px;
+}
+.install-receipt p,
+.install-receipt li {
+  font-size: 13px;
+  line-height: 1.7;
+}
+.integration-history summary {
+  cursor: pointer;
+  font-weight: 600;
+}
+.projects-page > .connection-panel {
+  margin-bottom: 20px;
+}
+.project-brief-status {
+  font-size: 12px;
+  color: var(--muted);
+}
+@media (max-width: 600px) {
+  .journey-heading,
+  .home-resume {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+  .journey-steps {
+    grid-template-columns: 1fr;
+  }
+  .journey-steps button {
+    min-height: 72px;
+  }
+  .home-resume button {
+    width: 100%;
+  }
+  .journey-heading .muted {
+    font-size: 12px;
+  }
+  .clipboard-filters button {
+    min-height: 44px;
+  }
+  .component-journey {
+    padding: 16px;
+  }
+}
+.component-journey {
+  padding: 20px;
+}
+.project-branding {
+  padding: 18px;
+  margin-bottom: 20px;
+}
+.project-branding > summary {
+  cursor: pointer;
+  font-size: 13px;
+}
+.project-branding .brand-detection {
+  margin-top: 18px;
+}
+.component-journey:focus-visible,
+.integration-review:focus-visible,
+.install-receipt:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 4px;
+}
+.working-preview {
+  padding: 24px;
+  margin: 24px 0;
+}
+.working-preview > .section-heading {
+  padding: 0;
+  align-items: center;
+}
+.working-preview > p {
+  font-size: 13px;
+  line-height: 1.7;
+  max-width: 780px;
+}
+.working-preview button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  min-height: 42px;
+}
+.preview-running {
+  font-size: 11px;
+  color: var(--muted);
+}
+.preview-controls,
+.preview-controls > [role='group'] {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.preview-controls {
+  margin: 18px 0;
+}
+.preview-controls [aria-pressed='true'] {
+  background: var(--text);
+  color: var(--surface);
+}
+.working-frame {
+  width: 100%;
+  background: var(--raised);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  overflow: hidden;
+}
+.working-frame.mobile {
+  width: min(100%, 390px);
+  margin: auto;
+}
+.working-frame iframe {
+  width: 100%;
+  height: 610px;
+  border: 0;
+  display: block;
+}
+.working-preview details {
+  font-size: 12px;
+  line-height: 1.7;
+  margin: 16px 0;
+}
+.working-preview summary {
+  cursor: pointer;
+}
+.working-preview > .browser-testing {
+  margin-top: 20px;
+}
+@media (max-width: 600px) {
+  .working-preview {
+    padding: 16px;
+  }
+  .working-preview .section-heading {
+    flex-wrap: wrap;
+  }
+  .working-frame iframe {
+    height: 560px;
+  }
+  .preview-controls > button {
+    flex: 1;
+  }
+}
 
-@media(max-width:1100px) and (min-width:601px){.journey-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media (max-width: 1100px) and (min-width: 601px) {
+  .journey-steps {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
 
-.app-recovery{max-width:640px;margin:12vh auto;padding:32px;line-height:1.7}.app-recovery button{min-height:44px}
+.app-recovery {
+  max-width: 640px;
+  margin: 12vh auto;
+  padding: 32px;
+  line-height: 1.7;
+}
+.app-recovery button {
+  min-height: 44px;
+}
