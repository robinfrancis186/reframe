+.agent-avatar {
+  display: inline-flex;
+  position: relative;
+  vertical-align: middle;
+  flex-shrink: 0;
+  aspect-ratio: 1;
+  line-height: 0;
+  isolation: isolate;
+}
+.agent-avatar > .agent-original {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  border-radius: 12px;
+  transform-origin: 50% 80%;
+}
+.avatar-symbol {
+  position: absolute;
+  top: 5%;
+  right: 5%;
+  display: grid;
+  place-items: center;
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  background: #f7f6f0;
+  color: #31322f;
+  box-shadow: 0 2px 12px #0004;
+  animation: avatar-pop 0.25s ease-out;
+}
+.avatar-thinking {
+  color: #946400;
+  background: #fff0b8;
+  top: -9%;
+  right: calc(50% - 16px);
+}
+.avatar-success {
+  background: #c9f5dc;
+  color: #235c43;
+}
+.avatar-error {
+  background: #ffe5bd;
+  color: #85541d;
+}
+.avatar-stopped {
+  background: #e0e0e4;
+  color: #575768;
+}
+.agent-avatar[data-mood='thinking'] > .agent-original {
+  animation: avatar-ponder 2s ease-in-out infinite;
+}
+.avatar-rays {
+  animation: avatar-glow 1.1s ease-in-out infinite;
+}
+.agent-avatar[data-mood='working'] > .agent-original {
+  animation: avatar-work 1.4s ease-in-out infinite;
+}
+.avatar-working svg {
+  animation: avatar-tool 1.2s ease-in-out infinite;
+}
+.agent-avatar[data-mood='greeting'] > .agent-original,
+.agent-avatar[data-mood='idle']:hover > .agent-original {
+  animation: avatar-wave 0.6s ease-in-out 2;
+}
+.agent-avatar[data-mood='success'] > .agent-original {
+  animation: avatar-hop 0.6s ease-in-out 2;
+}
+.agent-avatar[data-mood='error'] > .agent-original {
+  animation: avatar-shake 0.45s ease-in-out 2;
+}
+@keyframes avatar-wave {
+  50% {
+    transform: rotate(-4deg);
+  }
+}
+@keyframes avatar-pop {
+  from {
+    opacity: 0;
+    transform: translateY(5px) scale(0.7);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+@keyframes avatar-ponder {
+  50% {
+    transform: rotate(-3deg) translateY(-2px);
+  }
+}
+@keyframes avatar-glow {
+  50% {
+    opacity: 0.4;
+    filter: drop-shadow(0 0 4px #ffd369);
+  }
+}
+@keyframes avatar-work {
+  50% {
+    transform: translateY(-4px);
+  }
+}
+@keyframes avatar-tool {
+  50% {
+    transform: rotate(-12deg);
+  }
+}
+@keyframes avatar-hop {
+  50% {
+    transform: translateY(-7px);
+  }
+}
+@keyframes avatar-shake {
+  25% {
+    transform: rotate(-4deg);
+  }
+  75% {
+    transform: rotate(4deg);
+  }
+}
+.agent-portrait .agent-avatar {
+  width: 100% !important;
+  height: 100%;
+}
+.agent-portrait .agent-avatar > .agent-original {
+  border-radius: 0;
+}
+.agent-portrait .avatar-thinking {
+  top: 5%;
+}
+.agent-timeline > li > .agent-avatar {
+  flex: 0 0 42px;
+}
+.helper-panel header .agent-avatar {
+  width: 64px !important;
+}
+.agent-tip .agent-avatar {
+  width: 56px !important;
+}
+.helper-launcher .agent-avatar {
+  width: 36px !important;
+  margin: -5px 0;
+}
+.test-host .agent-avatar {
+  width: 72px !important;
+}
+.helper-launcher {
+  align-items: center;
+  gap: 8px;
+}
+.agent-avatar[style*='42px'] .avatar-symbol,
+.agent-avatar[style*='40px'] .avatar-symbol {
+  width: 21px;
+  height: 21px;
+}
+.agent-avatar[style*='42px'] .avatar-symbol svg,
+.agent-avatar[style*='40px'] .avatar-symbol svg {
+  width: 14px;
+  height: 14px;
+}
+.agent-timeline .avatar-symbol {
+  top: -8px;
+}
+.agent-timeline .agent-avatar + div {
+  flex: 1;
+}
+@media (prefers-reduced-motion: reduce) {
+  .agent-avatar * {
+    animation: none !important;
+    transition: none !important;
+  }
+}
