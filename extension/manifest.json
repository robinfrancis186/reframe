{
  "manifest_version": 3,
  "name": "Reframe Picker",
  "version": "0.1.0",
  "description": "Pick a component on any page you have open and save it to your local Reframe library.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pick a component with Reframe"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Pick a component"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "pair-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
