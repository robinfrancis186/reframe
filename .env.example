# Optional: enables OpenAI decisions and screenshot reconstruction. Keep keys in .env, never in Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Decision planner uses this model; leave blank to reuse OPENAI_MODEL.
OPENAI_DECISION_MODEL=
# Optional absolute Python path if Gradio is installed outside .reframe/gradio-venv.
REFRAME_GRADIO_PYTHON=
# Optional Python interpreter for the graphifyy tool environment.
GRAPHIFY_PYTHON=
PORT=5173
